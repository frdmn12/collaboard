# --- Database (docker compose) ---
POSTGRES_DB=collabboard
POSTGRES_USER=bayu
POSTGRES_PASSWORD=secret123
# Backend dijalankan di host (npm run start:dev): Postgres dipetakan ke port 5433.
# Di dalam docker compose, nilai ini ditimpa oleh docker-compose.dev.yml (postgres:5432).
DB_HOST=localhost
DB_PORT=5433

# Redis: rate limit (dan nanti pub/sub WebSocket). Di docker compose ditimpa ke redis:6379.
REDIS_URL=redis://localhost:6379

# --- Backend ---
PORT=3000
FRONTEND_URL=http://localhost:5173
# Wajib, minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
SALT_ROUNDS=12
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# Cookie refresh token Secure. Default: true di production, false di development.
# COOKIE_SECURE=true

# Hanya untuk tes e2e (dipasang otomatis oleh suite yang relevan); ditolak di production.
# THROTTLE_DISABLED=true

# Dokumentasi API (Swagger UI di /docs, JSON di /docs-json). Default: aktif selain di production.
# Di production hanya menyala bila SWAGGER_ENABLED=true.
# SWAGGER_ENABLED=true

# --- Email (dev: Mailpit dari docker compose, inbox di http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_FROM=Collaboard <no-reply@collaboard.local>
